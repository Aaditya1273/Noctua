# Copy to .env.local and fill in. Without NEBIUS_API_KEY Noctua runs in clearly labelled demo mode.

# --- Nebius Token Factory (OpenAI-compatible) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Default model for every role. Verify the exact ID in your Token Factory catalogue (Settings → Check connection).
# Verified live on 2026-10-29: nvidia/nemotron-3-super-120b-a12b. (nvidia/Nemotron-3_5-Lightning was listed but
# returned no response within 120 s on the tested account.)
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional per-role overrides. Leave empty to use NEBIUS_MODEL for both.
NEBIUS_MODEL_FAST=
NEBIUS_MODEL_REASONING=
# Some models reject response_format=json_object; set to false if you see HTTP 400s.
NEBIUS_JSON_MODE=true
# Sends chat_template_kwargs.enable_thinking=false so Nemotron answers directly instead of spending tokens on reasoning.
NEBIUS_DISABLE_THINKING=true
NEBIUS_TIMEOUT_MS=45000
NEBIUS_MAX_RETRIES=2
NEBIUS_MAX_OUTPUT_TOKENS=2048

# USD per 1M tokens. Costs (and the monetary cap) are only computed for models listed here.
# These figures are from a third-party listing (mastra.ai Nebius provider page, Oct 2026) — confirm on
# your Token Factory pricing page before relying on them.
NEBIUS_PRICING={"nvidia/Nemotron-3_5-Lightning":{"input":0.06,"output":0.24},"nvidia/nemotron-3-super-120b-a12b":{"input":0.30,"output":0.90}}

# --- Daily limits (editable in Settings; settings saved in the UI override these) ---
DAILY_MODEL_CALL_LIMIT=60
DAILY_TOKEN_LIMIT=400000
DAILY_BUDGET_USD=0.50
DAILY_RISK_POINTS=10
BUDGET_DOWNGRADE_AT=0.8

# --- Storage ---
# NOCTUA_DB_PATH=./data/noctua.db
# NOCTUA_SIGNING_KEY_PATH=./data/signing-key.pem

# --- Optional HTTP Basic auth for any deployment beyond localhost ---
# NOCTUA_BASIC_AUTH=user:a-long-random-password
